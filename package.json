{
  "name": "@cocreate/cursors",
  "version": "1.30.0",
  "description": "Collaborative cursor overlays for CoCreate Text and Editor surfaces.",
  "keywords": [
    "cursors",
    "collaborative-cursors",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Collaborative cursor overlays for CoCreate Text and Editor surfaces.",
      "source": "src/index.js",
      "declarative": {
        "attributes": [
          {
            "name": "aria-hidden"
          },
          {
            "name": "class"
          },
          {
            "name": "crdt"
          },
          {
            "name": "cursors"
          },
          {
            "name": "data-editor-cursors"
          },
          {
            "name": "style"
          }
        ]
      },
      "api": {
        "exports": [
          "attachEditorCursors"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-cursors.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-cursors/issues"
  },
  "homepage": "https://cocreate.app/docs/cursors",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "dependencies": {
    "@cocreate/utils": "^1.57.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/utils@1.57.0": true,
    "@cocreate/webpack@1.9.0": true
  }
}
